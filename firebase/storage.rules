rules_version = '2';
// Los PDF de papel sellado de cada usuario: users/{uid}/files/{id}.pdf, solo del dueño y de hasta 20 MB.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 20 * 1024 * 1024 && request.resource.contentType == 'application/pdf';
    }
  }
}
